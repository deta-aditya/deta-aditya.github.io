---
import NavigationLink from '../components/NavigationLink.astro';
import '../styles/global.css';

const { title } = Astro.props;
const displayTitle = title ? `${title} · Deta Aditya` : 'Deta Aditya';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{displayTitle}</title>
	</head>
	<body>
		<main class="flex container mx-auto gap-8">
			<aside class="w-64">
				<header class="py-12 h-32">
					<h1 class="font-bold text-2xl">
						<a href="/">Deta Aditya</a>
					</h1>
				</header>
				<nav>
					<ul>
						<NavigationLink href="/articles">Articles</NavigationLink>
						<NavigationLink href="/portfolio">Portfolio</NavigationLink>
						<NavigationLink href="/experiences">Experiences</NavigationLink>
						<NavigationLink href="/contact">Contact</NavigationLink>
					</ul>
				</nav>
			</aside>
			<section class="flex-1 mt-32 ml-16">
				<slot />
			</section>
		</main>
	</body>
</html>
